# URL del API Gateway desplegado con CDK.
# Copia este archivo a .env y reemplaza con la URL de tu API.
# Ejemplo:
# VITE_API_URL=https://abc123.execute-api.us-east-1.amazonaws.com/prod/
#
# En produccion (desplegado en S3+CloudFront), el CDK despliega un config.json
# con la URL correcta, por lo que esta variable no es necesaria.
VITE_API_URL=
